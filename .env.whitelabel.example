# New installs use PostgreSQL 18. Keep 16-alpine for existing PostgreSQL 16
# volumes until their data has been dumped and restored into PostgreSQL 18.
POSTGRES_IMAGE_TAG=18-alpine
POSTGRES_PORT=5432
ADMINER_PORT=8080
WEB_PORT=3000
DATABASE_URL=postgres://postgres:postgres@postgres:5432/getcito
DEPLOYMENT_MODE=whitelabel
VITE_DEPLOYMENT_MODE=whitelabel
BETTER_AUTH_SECRET=replace-with-random-hex
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000
VITE_APP_TIMEZONE=Asia/Kolkata
VITE_APP_LOCALE=en-IN

AUTH0_DOMAIN=example.auth0.com
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me
AUTH0_AUDIENCE=
AUTH0_SCOPE=openid profile email
AUTH0_MGMT_API_DOMAIN=example.auth0.com
VITE_AUTH0_DOMAIN=example.auth0.com
VITE_AUTH0_CLIENT_ID=replace-me
VITE_APP_NAME=GetCito
VITE_APP_ICON=https://example.com/icon.png
VITE_APP_PARENT_NAME=GetCito
VITE_APP_PARENT_URL=https://www.getcito.com
VITE_OPTIMIZATION_URL_TEMPLATE=
VITE_ONBOARDING_REDIRECT_URL_TEMPLATE=

SCRAPE_TARGETS=chatgpt:openai-api
ONBOARDING_LLM_TARGET=chatgpt:openai-api
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_BASE_URL=
CLORO_API_KEY=
OLOSTEP_API_KEY=
BRIGHTDATA_API_TOKEN=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
